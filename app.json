{
  "expo": {
    "name": "Monorec",
    "slug": "recipes",
    "scheme": "monorec",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.neyroshi.monorec",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.neyroshi.monorec",
      "adaptiveIcon": {
        "backgroundColor": "#202321",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "name": "Рецепты",
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-router",
        {
          "asyncRoutes": { "web": false }
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "59088891-882c-4800-8df7-4f1e51cad919"
      }
    },
    "owner": "neyroshi",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/59088891-882c-4800-8df7-4f1e51cad919"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
